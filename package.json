{
  "name": "RestoCalculateur",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "start:built": "npm run build && electron .",
    "build:win": "npm run build && npx electron-builder --win",
    "postinstall": "node scripts/copy-libs.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.1.2"
  },
  "build": {
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^40.10.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.13",
    "vite": "^7.1.3",
    "vitest": "^4.1.10",
    "wait-on": "^7.0.1",
    "xlsx-js-style": "^1.2.0"
  }
}
